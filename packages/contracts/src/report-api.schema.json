{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weekly-status.local/schemas/report-api.schema.json",
  "title": "Weekly Status Report API contracts",
  "$defs": {
    "generateReportRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preparedBy"
      ],
      "properties": {
        "weekStart": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Optional Monday in YYYY-MM-DD format; server applies the configured timezone default."
        },
        "preparedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "executiveSummary": {
          "type": "string",
          "maxLength": 2000
        },
        "riskItems": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "apiError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "correlationId": {
              "type": "string"
            },
            "details": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "reportSummary": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "team",
                "weekStart",
                "weekEnd",
                "preparedBy",
                "generatedAt",
                "status"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "team": {
                  "type": "string"
                },
                "weekStart": {
                  "type": "string",
                  "format": "date"
                },
                "weekEnd": {
                  "type": "string",
                  "format": "date"
                },
                "preparedBy": {
                  "type": "string"
                },
                "generatedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "status": {
                  "enum": [
                    "On Track",
                    "At Risk",
                    "Delayed"
                  ]
                }
              }
            },
            "reportDetail": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "team",
                "weekStart",
                "weekEnd",
                "preparedBy",
                "generatedAt",
                "status",
                "markdown"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "team": {
                  "type": "string"
                },
                "weekStart": {
                  "type": "string",
                  "format": "date"
                },
                "weekEnd": {
                  "type": "string",
                  "format": "date"
                },
                "preparedBy": {
                  "type": "string"
                },
                "generatedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "status": {
                  "enum": [
                    "On Track",
                    "At Risk",
                    "Delayed"
                  ]
                },
                "markdown": {
                  "type": "string"
                }
              }
            },
            "reportListResponse": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "items",
                "page",
                "pageSize",
                "total"
              ],
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/reportSummary"
                  }
                },
                "page": {
                  "type": "integer",
                  "minimum": 1
                },
                "pageSize": {
                  "const": 20
                },
                "total": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "reportDetailResponse": {
              "$ref": "#/$defs/reportDetail"
            },
            "generateReportResponse": {
              "$ref": "#/$defs/reportDetail"
            }
          }
        }
      }
    }
  }
}
